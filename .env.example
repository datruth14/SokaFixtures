# Server-only credentials; configure these in Vercel, never in browser code.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

RESEND_API_KEY=
RESEND_FROM_EMAIL=

PAYSTACK_SECRET_KEY=
PAYSTACK_PLAN_CODE=

# Leave disabled until the full Paystack test-mode flow has been verified.
BILLING_ENABLED=false

# Enable only after completing the full Paystack test-mode checklist.
PAYSTACK_ALLOW_LIVE=false

# Optional newer Paystack webhook signing secret (whsec_...).
PAYSTACK_WEBHOOK_SECRET=

# A random secret used by Vercel to authenticate the daily billing-email cron.
CRON_SECRET=
